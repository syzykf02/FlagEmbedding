{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Attach using Process Id",
            "type": "debugpy",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/work",
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Python Debugger: mteb",
            "type": "debugpy",
            "request": "launch",
            "module": "FlagEmbedding.evaluation.mteb",
            "args": [
                "--eval_name",
                "mteb",
                "--output_dir",
                "./mteb/search_results",
                "--languages",
                "eng",
                "--tasks",
                "NFCorpus",
                "BiorxivClusteringS2S",
                "SciDocsRR",
                "--eval_output_path",
                "./mteb/mteb_eval_results.json",
                "--embedder_name_or_path",
                "BAAI/bge-m3",
                "--devices",
                "cuda:0",
                "--cache_dir",
                "/home/zhangx/.cache/huggingface/hub"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/examples/evaluation",
            "justMyCode": false
        },
        {
            "name": "Python Debugger: scs",
            "type": "debugpy",
            "request": "launch",
            "module": "FlagEmbedding.evaluation.custom",
            "args": [
                "--eval_name",
                "scs_data",
                "--dataset_dir",
                "./scs_data",
                "--splits",
                "test",
                "--corpus_embd_save_dir",
                "./scs_data/corpus_embd",
                "--output_dir",
                "./scs_data/search_results",
                "--search_top_k",
                "1000",
                "--rerank_top_k",
                "100",
                "--cache_path",
                "./cache/data",
                "--overwrite",
                "True",
                "--k_values",
                "10",
                "100",
                "--eval_output_method",
                "markdown",
                "--eval_output_path",
                "./scs_data/eval_results.md",
                "--eval_metrics",
                "ndcg_at_10",
                "recall_at_100",
                "--embedder_name_or_path",
                "BAAI/bge-m3",
                "--reranker_name_or_path",
                "BAAI/bge-reranker-v2-m3",
                "--devices",
                "cuda:0",
                "--cache_dir",
                "./cache/model",
                "--reranker_query_max_length",
                "512",
                "--reranker_max_length",
                "1024"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/work",
            "justMyCode": false
        }, 
        {
            "name": "Debug FlagEmbedding Custom Eval",
            "type": "debugpy",
            "request": "launch",
            "module": "FlagEmbedding.evaluation.custom",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "HF_ENDPOINT": "https://hf-mirror.com"
            },
            "args": [
                "--eval_name", "scs_data",
                "--dataset_dir", "./work/scs_data",
                "--splits", "test",
                "--corpus_embd_save_dir", "./work/scs_data/corpus_embd",
                "--output_dir", "./work/scs_data/search_results",
                "--search_top_k", "1000",
                "--rerank_top_k", "100",
                "--cache_path", "./work/cache/data",
                "--overwrite", "True",
                "--k_values", "10", "100",
                "--eval_output_method", "markdown",
                "--eval_output_path", "./work/scs_data/eval_results.md",
                "--eval_metrics", "ndcg_at_10", "recall_at_100",
                "--embedder_name_or_path", "BAAI/bge-m3",
                "--reranker_name_or_path", "BAAI/bge-reranker-v2-m3",
                "--devices", "cuda:0",
                "--cache_dir", "./work/cache/model",
                "--reranker_query_max_length", "512",
                "--reranker_max_length", "1024"
            ],
            "cwd": "${workspaceFolder}",
        }
    ]
}